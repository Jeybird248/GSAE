Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

%post
    chmod 1777 /tmp
    export DEBIAN_FRONTEND=noninteractive
    export TMPDIR=/opt/tmp
    export UV_CACHE_DIR=/opt/uv_cache
    export UV_HTTP_TIMEOUT=600
    mkdir -p "${TMPDIR}" "${UV_CACHE_DIR}"

    apt-get update && apt-get install -y \
        python3.10 \
        python3.10-dev \
        python3-pip \
        python3-venv \
        git \
        curl \
        wget \
        ca-certificates \
        build-essential \
        procps \
        ripgrep \
        && rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/python3.10 /usr/bin/python3
    ln -sf /usr/bin/python3.10 /usr/bin/python
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    uv pip install --system --no-cache \
        --index-url https://download.pytorch.org/whl/cu118 \
        torch==2.1.2

    uv pip install --system --no-cache \
        accelerate \
        datasets \
        joblib \
        numpy \
        pyyaml \
        scikit-learn==1.2.2 \
        safetensors \
        sentencepiece \
        protobuf \
        tiktoken \
        tqdm \
        transformers==4.55.0 \
        pytest

%environment
    export PATH="/root/.local/bin:$PATH"
    export HF_HUB_ENABLE_HF_TRANSFER=0
    export TOKENIZERS_PARALLELISM=false
    export PYTHONUNBUFFERED=1

%runscript
    exec "$@"

%labels
    Version v0.1.0
    Description Graph-Regularized SAE safety steering runtime

%help
    Build with scripts/build_container.sh and run with scripts/run_in_container.sh.
    Use --nv for GPU-backed Hugging Face activation collection and generation.
