universe = vanilla
executable = /bin/bash
arguments = /lustre/home/jyeon/gsae/scripts/run_stage_in_container.sh $(stage) /lustre/home/jyeon/gsae/configs/default.yaml
initialdir = /lustre/home/jyeon/gsae
should_transfer_files = NO
getenv = True
environment = "USE_NV=1"
stream_output = True
stream_error = True
output = /fast/jyeon/gsae/logs/$(stage)_$(Cluster).out
error = /fast/jyeon/gsae/logs/$(stage)_$(Cluster).err
log = /fast/jyeon/gsae/logs/$(stage)_$(Cluster).log
# Paper, Appendix C.1: single NVIDIA A100 GPU with 40 GB VRAM.
request_gpus = 1
require_gpus = regexp("A100", DeviceName) && (GlobalMemoryMb >= 40000)
+BypassLXCfs = "true"
stage = smoke
queue
